{
  "name": "yome",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@apps/web",
    "dev:gateway": "turbo run dev --filter=@services/gateway",
    "dev:services": "concurrently -n g,auth,chat,media,notif \"bun run --cwd services/gateway dev\" \"bun run --cwd services/auth dev\" \"bun run --cwd services/chat dev\" \"bun run --cwd services/media dev\" \"bun run --cwd services/notifications dev\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:migrate": "turbo run db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.8.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ]
}
