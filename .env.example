# Copy to .env and fill in values.
#
# ─── Gateway & Service Ports ───
GATEWAY_PORT=4100
AUTH_SERVICE_PORT=4101
USER_SERVICE_PORT=4102
CHAT_SERVICE_PORT=4103
MEDIA_SERVICE_PORT=4104
NOTIFICATIONS_SERVICE_PORT=4105

AUTH_SERVICE_URL=http://localhost:4101
USER_SERVICE_URL=http://localhost:4102
CHAT_SERVICE_URL=http://localhost:4103
MEDIA_SERVICE_URL=http://localhost:4104
NOTIFICATIONS_SERVICE_URL=http://localhost:4105

GATEWAY_REQUIRE_AUTH=true
GATEWAY_SHARED_TOKEN=change-me

# Required for gateway JWT verification (must match Next.js NEXTAUTH_SECRET)
NEXTAUTH_SECRET=your_nextauth_secret_here
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_MAX_REQUESTS=120

# ─── Database (Supabase) ───
# Pooled connection (for app runtime via pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection (for migrations — port 5432, no pgbouncer)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ─── Frontend ───
# API requests go through the gateway (use gateway port, not a service port).
NEXT_PUBLIC_BACKEND_API=http://localhost:4100
# Socket.IO connects directly to the chat service (WebSocket cannot be proxied via gateway).
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:4103
# Public URL of the web app (used for CORS, callbacks, redirects). Prefer FRONTEND_URL.
FRONTEND_URL=http://localhost:3000
# Legacy alias (used by chat service Socket.io CORS); migrate to FRONTEND_URL in config
FRONTEND_CLIENT_PORT=http://localhost:3000

# ─── JWT ───
JWT_KEY=your_jwt_secret_key_here

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Zego (Video Call) ───
ZEGO_APP_ID=your_zego_app_id
ZEGO_APP_SECRET=your_zego_app_secret

# ─── Stream (Chat/Video SDK) ───
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_SECRET_KEY=your_stream_secret_key
