# Yome — environment template
#
# Copy to `.env` in the repo root and fill in values. One root `.env` is loaded by
# every app, service, and Prisma script (see README.md). Keep `.env` out of git.
#
# Only variables the code actually reads are listed. Uncommented keys are expected to
# be set; commented keys are optional and show their default. Every key here is also
# declared in `turbo.json` -> `globalEnv`, so changing it busts the Turbo build cache.
# Deployed values (Railway / Vercel) are covered in docs/DEPLOYMENT.md.

# ─── Service ports ────────────────────────────────────────────────────────
GATEWAY_PORT=4100
IDENTITY_SERVICE_PORT=4101
MESSAGING_SERVICE_PORT=4103
MEDIA_SERVICE_PORT=4104
NOTIFICATIONS_SERVICE_PORT=4105
CORE_SERVICE_PORT=4107

# ─── Internal service URLs (gateway -> services; media -> messaging) ──────
IDENTITY_SERVICE_URL=http://localhost:4101
MESSAGING_SERVICE_URL=http://localhost:4103
MEDIA_SERVICE_URL=http://localhost:4104
NOTIFICATIONS_SERVICE_URL=http://localhost:4105
CORE_SERVICE_URL=http://localhost:4107

# ─── Gateway & internal trust ─────────────────────────────────────────────
# Shared by apps/web, the gateway and every service. Generate: openssl rand -hex 32
GATEWAY_SHARED_TOKEN=
GATEWAY_REQUIRE_AUTH=true
# Leave on; "false" disables the internal-token check (isolated local debugging only).
# INTERNAL_TOKEN_GUARD_ENABLED=true
# GATEWAY_RATE_WINDOW_MS=60000
# GATEWAY_RATE_MAX_REQUESTS=120

# ─── Auth (NextAuth) ──────────────────────────────────────────────────────
# Signs sessions and socket tokens; the gateway and messaging verify with it.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# Only needed if NextAuth can't infer the site URL from request headers (set it in production).
# NEXTAUTH_URL=http://localhost:3000

# OAuth providers: optional, only for the social sign-in buttons you use.
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_API=http://localhost:4100
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:4103
# The web app's origin: used for CORS (gateway, Socket.IO) and absolute links.
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────
# Local dev: `bun run infra:up` (docker-compose.yml), then:
DATABASE_URL=postgresql://yome:yome@localhost:5440/yome
DIRECT_URL=postgresql://yome:yome@localhost:5440/yome
# Prisma pg pool size per process.
# DATABASE_POOL_MAX=2

# ─── Redis (presence, Socket.IO fan-out, rate limiting, cache-aside) ──────
REDIS_URL=redis://localhost:6379
# REDIS_PRESENCE_TTL_SECONDS=60
# CACHE_TTL_DASHBOARD_SECONDS=60

# ─── Object storage (S3-compatible; set up for Supabase Storage) ──────────
# Supabase: Project Settings -> Storage -> S3 Connection (create an access key).
# For plain AWS S3, leave AWS_S3_ENDPOINT unset and drop AWS_S3_FORCE_PATH_STYLE.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# Key prefix inside the bucket, e.g. yome/prod.
# AWS_S3_PREFIX=
# A CDN in front of the bucket; when set it replaces AWS_S3_PUBLIC_BASE_URL in public URLs.
# AWS_CLOUDFRONT_URL=
# Only "s3" is supported.
# STORAGE_PROVIDER=s3

# ─── Stream (calls / video) ───────────────────────────────────────────────
# Public key: read by apps/web (client SDK) and services/messaging (server SDK).
NEXT_PUBLIC_STREAM_API_KEY=
# Server secret: read only by services/messaging.
STREAM_SECRET_KEY=

# ─── Dev-only routes — NEVER enable in a deployed environment ─────────────
# Seed / reset endpoints under /api/dev/db/* and /api/db/*.
ENABLE_DEV_SEED_ROUTES=false
# Required by the destructive reset route (sent as the x-dev-seed-token header).
DEV_SEED_ROUTE_TOKEN=
# Lets /api/auth/sync-user take identity from the request body with no session.
ENABLE_DEV_USER_SYNC=false
