# Yome — environment template
#
# Copy to `.env` in the repo root and fill in values. One root `.env` is loaded by
# every app, service, and Prisma script (see README.md). Keep `.env` out of git.
#
# Every key listed here that is read by application code is also declared in
# `turbo.json` -> `globalEnv`, so changing it correctly busts the Turbo build cache.

# ─── Gateway & service ports ───────────────────────────────────────────────
GATEWAY_PORT=4100
IDENTITY_SERVICE_PORT=4101
USER_SERVICE_PORT=4102
CHAT_SERVICE_PORT=4103
MEDIA_SERVICE_PORT=4104
NOTIFICATIONS_SERVICE_PORT=4105
# CORE_SERVICE_PORT is the consolidated service introduced in B06 (community, then
# learning + resources in B07 — services/resources no longer exists as its own service).
CORE_SERVICE_PORT=4107

# ─── Internal service URLs (gateway -> downstream) ─────────────────────────
IDENTITY_SERVICE_URL=http://localhost:4101
USER_SERVICE_URL=http://localhost:4102
CHAT_SERVICE_URL=http://localhost:4103
MEDIA_SERVICE_URL=http://localhost:4104
NOTIFICATIONS_SERVICE_URL=http://localhost:4105
CORE_SERVICE_URL=http://localhost:4107

# ─── Gateway behaviour ────────────────────────────────────────────────────
GATEWAY_REQUIRE_AUTH=true
GATEWAY_SHARED_TOKEN=
INTERNAL_TOKEN_GUARD_ENABLED=true
GATEWAY_RATE_WINDOW_MS=60000
GATEWAY_RATE_MAX_REQUESTS=120

# ─── Auth / session ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=
# NEXTAUTH_URL is only required if NextAuth cannot infer the site URL from request headers.
# NEXTAUTH_URL=http://localhost:3000

# ─── OAuth providers (optional; only needed for social sign-in) ───────────
GOOGLE_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ─── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
# Prisma pg pool size per process (packages/database/src/client.js). Default 2.
DATABASE_POOL_MAX=2

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_API=http://localhost:4100
NEXT_PUBLIC_CHAT_SOCKET_URL=http://localhost:4103
FRONTEND_URL=http://localhost:3000
# FRONTEND_CLIENT_PORT is a legacy alias for FRONTEND_URL; prefer FRONTEND_URL.
FRONTEND_CLIENT_PORT=http://localhost:3000

# ─── Object storage (S3) ────────────────────────────────────────────────
STORAGE_PROVIDER=s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# One of AWS_S3_PUBLIC_BASE_URL or AWS_CLOUDFRONT_URL is required.
AWS_S3_PUBLIC_BASE_URL=
AWS_CLOUDFRONT_URL=
AWS_S3_PREFIX=

# ─── Stream (chat/video SDK) ───────────────────────────────────────────
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# ─── Dev-only routes — NEVER enable in a deployed environment ───────────
# Seed / reset endpoints under /api/dev/db/* and /api/db/*.
ENABLE_DEV_SEED_ROUTES=false
# Required by the destructive reset route (sent as the x-dev-seed-token header).
DEV_SEED_ROUTE_TOKEN=
# Allows /api/auth/sync-user to take identity from the request body with no session.
# Local OAuth debugging only. Defaults off; the route is session-only unless this is "true".
ENABLE_DEV_USER_SYNC=false

# ─── Reserved for later phases (see docs/services_packages_refactoring) ──
# Phase 2 (B11) introduces Redis for presence, socket fan-out, rate limiting, and cache.
# REDIS_URL=redis://localhost:6379
