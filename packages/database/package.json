{
  "name": "@repo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/client.js",
  "exports": {
    ".": {
      "types": "./src/client.d.ts",
      "import": "./src/client.js",
      "default": "./src/client.js"
    }
  },
  "scripts": {
    "db:migrate": "bun --env-file=../../.env prisma migrate deploy --schema ./prisma/schema.prisma",
    "generate": "bun --env-file=../../.env prisma generate --schema ./prisma/schema.prisma",
    "postinstall": "bun --env-file=../../.env prisma generate --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@prisma/adapter-pg": "5.22.0",
    "dotenv": "^17.2.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
