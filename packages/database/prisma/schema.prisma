generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  AGENT
  STAFF
  ADMIN
  MENTOR
  TEACHER
  STUDENT
}

model User {
  id                        Int                     @id @default(autoincrement())
  firstname                 String
  lastname                  String
  name                      String?
  email                     String                  @unique
  username                  String                  @unique
  password                  String
  profilePicture            String                  @default("")
  identifier                String                  @default("user")
  created_at                DateTime                @default(now())
  updated_at                DateTime                @updatedAt
  userProfile               UserProfile?            @relation(fields: [userProfileId], references: [id])
  userProfileId             String?                 @unique
  sentMessages              Messages[]              @relation("sentMessages")
  receivedMessages          Messages[]              @relation("receivedMessages")
  forgotPasswordToken       String?
  forgotPasswordTokenExpiry DateTime?
  verifyToken               String?
  verifyTokenExpiry         DateTime?
  groupAdmin                Group[]                 @relation("AdminOfGroup")
  group                     Group[]                 @relation("MembersOfGroup")
  directConversationsA      Conversation[]          @relation("ConversationParticipantA")
  directConversationsB      Conversation[]          @relation("ConversationParticipantB")
  role                      Role                    @default(USER)
  posts                     Post[]
  comments                  Comment[]
  likes                     Like[]
  authoredResources         Resource[]              @relation("ResourceAuthor")
  savedResources            ResourceSave[]
  helpfulResourceVotes      ResourceHelpfulVote[]
  groupInvitations          GroupInvitation[]
  groupAnnouncements        GroupAnnouncement[]
  followers                 User[]                  @relation("Followers")
  following                 User[]                  @relation("Followers")
  messagesSeen              Messages[]              @relation(name: "MessageSeenBy")

  @@index([email])
}

model UserProfile {
  id         String   @id @default(uuid())
  user       User?
  bio        String   @default("")
  address    String   @default("")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Messages {
  id            Int      @id @default(autoincrement())
  sender        User?    @relation("sentMessages", fields: [senderId], references: [id])
  senderId      Int
  receiver      User?    @relation("receivedMessages", fields: [receiverId], references: [id])
  receiverId    Int?
  conversation  Conversation? @relation(fields: [conversationId], references: [id])
  conversationId String?
  seenBy        User[]   @relation("MessageSeenBy")
  type          String   @default("text")
  message       String
  msgType       String   @default("")
  messageStatus String   @default("sent")
  group         Group?   @relation(fields: [groupId], references: [id])
  groupId       String?
  createdAt     DateTime @default(now())

  @@index([conversationId])
}

model Group {
  id             String              @id @default(uuid())
  slug           String              @unique
  name           String              @unique
  about          String              @default("")
  identifier     String              @default("group")
  subject        String              @default("General")
  category       String              @default("Community")
  tone           String              @default("blue")
  symbol         String              @default("Y")
  privacy        String              @default("Public group")
  location       String              @default("Global")
  featured       Boolean             @default(false)
  activeThisWeek Int                 @default(0)
  projectCount   Int                 @default(0)
  mentorCount    Int                 @default(0)
  admins         User[]              @relation("AdminOfGroup")
  members        User[]              @relation("MembersOfGroup")
  messages       Messages[]
  thumbnail      String              @default("")
  tags           GroupTag[]
  invitations    GroupInvitation[]
  announcements  GroupAnnouncement[]
  events         GroupEvent[]
  resources      Resource[]
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  @@index([subject])
  @@index([featured])
}

model GroupTag {
  id      String @id @default(uuid())
  label   String
  tone    String @default("neutral")
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  @@unique([groupId, label])
  @@index([groupId])
}

model GroupInvitation {
  id        String   @id @default(uuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([userId])
  @@index([status])
}

model GroupAnnouncement {
  id        String   @id @default(uuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  title     String
  body      String
  ctaLabel  String?
  ctaHref   String?
  pinned    Boolean  @default(false)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([pinned])
}

model GroupEvent {
  id        String   @id @default(uuid())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  title     String
  type      String
  startsAt  DateTime
  location  String   @default("Group room")
  tone      String   @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([startsAt])
}

model Conversation {
  id             String     @id @default(uuid())
  participantA   User       @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantAId Int
  participantB   User       @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  participantBId Int
  messages       Messages[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model Post {
  id          Int       @id @default(autoincrement())
  description String
  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int
  comments    Comment[]
  likes       Like[]
}

model Comment {
  id          Int    @id @default(autoincrement())
  description String
  author      User   @relation(fields: [authorId], references: [id])
  authorId    Int
  post        Post   @relation(fields: [postId], references: [id])
  postId      Int
}

model Like {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  post   Post @relation(fields: [postId], references: [id])
  postId Int
}

model Resource {
  id            String                 @id @default(uuid())
  slug          String                 @unique
  title         String
  subject       String
  topic         String
  level         String
  type          String
  tone          String
  description   String
  author        User                   @relation("ResourceAuthor", fields: [authorId], references: [id])
  authorId      Int
  group         Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId       String?
  fileUrl       String?
  externalUrl   String?
  saveCount     Int                    @default(0)
  helpfulCount  Int                    @default(0)
  ratingAverage Float?
  ratingCount   Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  saves         ResourceSave[]
  helpfulVotes  ResourceHelpfulVote[]

  @@index([subject])
  @@index([topic])
  @@index([level])
  @@index([type])
  @@index([authorId])
  @@index([groupId])
}

model ResourceSave {
  id         String   @id @default(uuid())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([userId])
}

model ResourceHelpfulVote {
  id         String   @id @default(uuid())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  createdAt  DateTime @default(now())

  @@unique([resourceId, userId])
  @@index([userId])
}
